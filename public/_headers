/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/pdfjs/*
  Cache-Control: public, max-age=86400

/fonts/latin-modern/v2.005/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/cloud
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/shared
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/cloud.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/shared.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
